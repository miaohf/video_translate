# 视频翻译API服务器配置
API_HOST=0.0.0.0
API_PORT=9000
API_WORKERS=1
API_BASE_URL=http://localhost:9000

# 翻译服务配置
STT_SERVER_URL=http://localhost:8001
TTS_SERVER_URL=http://localhost:8002

# 翻译模式配置
# 当前只支持: batch (批量翻译)
TRANSLATION_MODE=batch

# Ollama API 配置
OLLAMA_SERVER_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# 任务配置
DEFAULT_ESTIMATED_DURATION=1800
TASK_CHECK_INTERVAL=10

# 文件路径配置
TEMP_DIR=temp
OUTPUT_DIR=output

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 音频处理配置
FADE_DURATION=150
BACKGROUND_MIN_VOLUME=0.05

# TTS配置
TTS_TEMPERATURE=0.8
TTS_TOP_K=50
TTS_TOP_P=0.95
TTS_SEED_BASE=421 