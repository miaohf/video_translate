[Unit]
Description=视频翻译API服务器
After=network.target

[Service]
Type=simple
User=miaohf
Group=miaohf
WorkingDirectory=/home/miaohf/Documents/mycode/video_translate
Environment=PATH=/home/miaohf/Documents/mycode/video_translate/.venv/bin
ExecStart=/home/miaohf/Documents/mycode/video_translate/.venv/bin/python start_api_server_prod.py
Restart=always
RestartSec=10

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/miaohf/Documents/mycode/video_translate
PrivateTmp=true

# 日志设置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=video-translate-api

[Install]
WantedBy=multi-user.target 